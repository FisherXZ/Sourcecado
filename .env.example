# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local — it's in .gitignore.

# Postgres connection (matches docker-compose.yml defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sourcecado
POSTGRES_USER=sourcecado
POSTGRES_PASSWORD=sourcecado

# Constructed from the above — used by the DB client
DATABASE_URL=postgresql://sourcecado:sourcecado@localhost:5432/sourcecado

# Model Gateway generation provider (anthropic | deepseek)
# NOTE: provider defaults to deepseek when unset, so set this to anthropic if you
# only have an ANTHROPIC_API_KEY (a real sk-ant-api03 key, not an OAuth token).
SOURCECADO_GENERATION_PROVIDER=anthropic
SOURCECADO_GENERATION_MODEL=claude-sonnet-4-6
DEEPSEEK_API_KEY=

# Model Gateway embedding provider
OPENAI_API_KEY=
SOURCECADO_EMBEDDING_MODEL=text-embedding-3-small
SOURCECADO_EMBEDDING_DIMENSIONS=1536

# Local-only raw run payload inspector. Disabled in production even when true.
SOURCECADO_ENABLE_RUN_INSPECTOR=
ANTHROPIC_API_KEY=

# R7 external tools
TAVILY_API_KEY=
APOLLO_API_KEY=
# Opt-in: run the real-network live-smoke tests in tests/web-fetch-tool.test.ts
# and tests/web-search-tool.test.ts. Both skip by default so external state
# (network reachability, Tavily account quota) can't turn the suite red.
# (Apollo has no live-smoke test — its live smoke is deferred until the key is provided.)
SOURCECADO_RUN_LIVE_SMOKE=

# Google OAuth (H1). Create a Web application OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
# Must match the port Next actually binds. Next falls forward to 3001 when 3000
# is taken, and a mismatch sends the OAuth callback to the wrong origin — so
# register every port you use as a redirect URI on the Google client.
AUTH_URL=http://localhost:3000

# Who may sign in. Comma-separated; either or both. With neither set, any
# verified Google account is allowed in development and NONE in production —
# an unconfigured deploy fails closed rather than becoming an open sign-up.
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=
