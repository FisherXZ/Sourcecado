# Copy this file to ~/.config/club/.env. Never commit the populated file.

# Model providers. DeepSeek is preferred; Moonshot/Kimi is the fallback.
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# Optional provider override, for example deepseek-v4-pro or kimi-k3.
# CLUB_MODEL=

# Google OAuth for Gmail, Drive, and Calendar.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Sourcing and web-research connectors.
APOLLO_API_KEY=
TAVILY_API_KEY=

# Optional: put runtime databases and tokens in another local directory.
# CLUB_STATE_DIR=/absolute/path/to/sourcecado-state
